#!/bin/sh
# Guard: only allow pushes to the fork, never to the upstream repo.
# pre-push receives: $1 = remote name, $2 = remote URL

FORK="kgforais1/k-dense-byok-mcp"
url="$2"

# Match the exact owner/repo across URL styles (no bare owner substring):
#   https://github.com/kgforais1/k-dense-byok-mcp(.git)
#   ssh://git@github.com/kgforais1/k-dense-byok-mcp(.git)
#   git@github.com:kgforais1/k-dense-byok-mcp(.git)
case "$url" in
  *github.com/kgforais1/k-dense-byok-mcp|*github.com/kgforais1/k-dense-byok-mcp.git|\
*github.com:kgforais1/k-dense-byok-mcp|*github.com:kgforais1/k-dense-byok-mcp.git)
    # Fork guard passed. Check the caps against the git index, which on a
    # clean tree is what you are pushing. Two failures now, not one: a cap
    # left stale-high after a file shrank, and a file that exceeds its cap.
    # The second is the ESLint `max-lines` violation itself, caught here from
    # line counts rather than by running ESLint — neither `verify -- server`
    # nor `verify -- web` runs lint, so before this the first sight of it was
    # CI. It does not read the pushed ref range, so it judges the index rather
    # than the commits; CI lint remains the backstop.
    # Fail open when node is missing. A GUI git client inherits launchd's
    # PATH, which usually has no node, and blocking every push from one with
    # `command not found` — while the remedy also needs node — is how a hook
    # gets disabled. The fork guard above is the one that must never yield.
    if command -v node >/dev/null 2>&1; then
      repo_root="$(git rev-parse --show-toplevel)" || exit 1
      cd "$repo_root" || exit 1
      node scripts/repo.mjs ratchet:check || exit 1
    fi
    exit 0
    ;;
esac

echo >&2 ""
echo >&2 "BLOCKED: refusing to push to non-fork remote:"
echo >&2 "  remote: $1"
echo >&2 "  url:    $url"
echo >&2 ""
echo >&2 "This repository must only push to the fork ($FORK)."
echo >&2 "PRs must also target the fork: gh pr create --repo $FORK"
echo >&2 ""
echo >&2 "Do NOT bypass this hook (--no-verify) without explicitly asking the"
echo >&2 "user first and getting confirmation — see AGENTS.md."
exit 1
