{
  "name": "kady-server",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "prep": "tsx src/prep.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/patch-subagents.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/adm-zip": "^0.5.8",
    "acorn": "8.18.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "fastify": "^5.2.0",
    "modal": "^0.8.2",
    "pi-subagents": "0.78.0",
    "pi-web-access": "0.41.0",
    "skills": "1.7.2",
    "typebox": "^1.3.7",
    "undici": "8.12.3",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "undici": "$undici",
    "pi-web-access": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    },
    "@vitest/browser-webdriverio": "4.1.11"
  }
}
